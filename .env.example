# ─── Django ───────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=your-super-secret-key-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost 127.0.0.1

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
DB_NAME=cybershield_db
DB_USER=cybershield_user
DB_PASSWORD=cybershield_pass
DB_HOST=localhost
DB_PORT=5432

# ─── Redis (Celery + Django Channels) ────────────────────────────────────────
REDIS_HOST=localhost
REDIS_URL=redis://localhost:6379/0

# ─── Wazuh API (per-tenant credentials stored in DB, these are defaults) ─────
WAZUH_MANAGER_URL=https://your-wazuh-manager:55000
WAZUH_API_USER=wazuh
WAZUH_API_PASSWORD=wazuh_password
WAZUH_VERIFY_SSL=False

# ─── Frontend ─────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
