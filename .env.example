# ─── Django ───────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=your-super-secret-key-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost 127.0.0.1

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
DB_NAME=cybershield_db
DB_USER=cybershield_user
DB_PASSWORD=cybershield_pass
DB_HOST=localhost
DB_PORT=5432

# ─── Redis (Celery + Django Channels) ────────────────────────────────────────
REDIS_HOST=localhost
REDIS_URL=redis://localhost:6379/0

# ─── Wazuh API (per-tenant credentials stored in DB, these are defaults) ─────
WAZUH_MANAGER_URL=https://your-wazuh-manager:55000
WAZUH_API_USER=wazuh
WAZUH_API_PASSWORD=wazuh_password
WAZUH_VERIFY_SSL=False

# ─── Suricata EVE Watcher ─────────────────────────────────────────────────────
# SURICATA_API_TOKEN: A long-lived JWT for the suricata-watcher service account.
#   Generate with: python manage.py shell -c "
#     from authentication.models import User
#     from rest_framework_simplejwt.tokens import RefreshToken
#     u = User.objects.get(email='suricata@internal')
#     print(str(RefreshToken.for_user(u).access_token))"
# DEFAULT_TENANT_ID: UUID of the tenant that Suricata events are assigned to.
#   Find with: python manage.py shell -c "
#     from authentication.models import Tenant; print(Tenant.objects.first().id)"
SURICATA_API_TOKEN=your-suricata-service-account-jwt-here
DEFAULT_TENANT_ID=your-tenant-uuid-here

# ─── Security Clearance (RBAC Gate) ──────────────────────────────────────────
# Required to register SYS_ADMIN or SUPER_ADMIN roles via /api/auth/register/.
# ORG_MANAGER registering a new org does NOT need this code.
# Change this in production and communicate it securely to privileged operators.
CYBERSHIELD_ADMIN_CLEARANCE=SECURE_CYBER_SHIELD_2026

# ─── Google OAuth (optional — for "Continue with Google" signup flow) ─────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect origins should include: http://localhost:5173
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# ─── Frontend ─────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
