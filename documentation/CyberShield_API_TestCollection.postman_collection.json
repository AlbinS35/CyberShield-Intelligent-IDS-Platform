      "name": "🔐 1. Authentication",
      "item": [
        {
          "name": "TC-001 | Login — Valid Credentials",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('TC-001: Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('TC-001: Response has access token', function () {",
                  "    pm.expect(pm.response.json()).to.have.property('access');",
                  "});",
                  "pm.test('TC-001: Response has refresh token', function () {",
                  "    pm.expect(pm.response.json()).to.have.property('refresh');",
                  "});",
                  "pm.test('TC-001: Response contains user profile object', function () {",
                  "    pm.expect(pm.response.json()).to.have.property('user');",
                  "    pm.expect(pm.response.json().user).to.have.property('email');",
                  "    pm.expect(pm.response.json().user).to.have.property('role');",
                  "});",
                  "// Auto-save tokens to collection variables for all subsequent requests",
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    pm.collectionVariables.set('access_token', json.access);",
                  "    pm.collectionVariables.set('refresh_token', json.refresh);",
                  "    console.log('✅ Tokens saved. Role:', json.user.role);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@cybershield.local\",\n  \"password\": \"CyberShield@2026\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/auth/login/", "host": ["{{base_url}}"], "path": ["api", "auth", "login", ""] }
          }
        },
